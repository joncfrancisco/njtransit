/* ------------------------------------------------- callbacks -- */

switch (FEAT_TRAINS, SELF, sw_alp45dp_power_real, current_railtype) {
    ELRL: return 5360;
          return 3600;
}

switch (FEAT_TRAINS, SELF, sw_alp45dp_power_bal, current_railtype) {
    ELRL: return 2600;
          return 1800;
}

switch (FEAT_TRAINS, SELF, sw_alp45dp_effect, current_railtype) {
    ELRL: return visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 0, DISABLE_WAGON_POWER);
          return visual_effect_and_powered(VISUAL_EFFECT_DIESEL, 0, DISABLE_WAGON_POWER);
}

